@startuml context level
!include ../c4_templates/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма системы открытия депозитов

' Персонажи
Person(client_new, "Новый клиент", "Клиент, не имеющий доступа к интернет-банку")
Person(client_ib, "Клиент интернет-банка", "Существующий клиент с доступом к ИБ")
Person(manager_cc, "Менеджер кол-центра", "Обрабатывает заявки новых клиентов")
Person(manager_bo, "Менеджер бэк-офиса", "Подтверждает условия депозита в АБС")

' Системы
System(site, "Сайт банка", "Позволяет новым клиентам подавать заявки на депозиты")
System(ib, "Интернет-банк", "Позволяет существующим клиентам подавать заявки с персонализированными ставками")
System(cc_system, "Система кол-центра", "Управляет заявками новых клиентов и коммуникацией с менеджерами")
System(abs, "АБС (Ядро)", "Управляет депозитами, клиентами и ставками")
System(sms, "СМС-сервис", "Отправляет уведомления клиентам")
System(new_system, "Новая система депозитов", "Обрабатывает заявки, управляет ставками, интеграции")

' Связи
Rel(client_new, site, "Подаёт заявку", "HTTPS")
Rel(client_ib, ib, "Подаёт заявку", "HTTPS")
Rel(site, cc_system, "Передаёт заявку", "HTTPS/TLS")
Rel(site, new_system, "Передаёт заявку", "HTTPS")
Rel(ib, new_system, "Отправляет запросы", "HTTPS")
Rel(manager_cc, cc_system, "Обрабатывает заявки", "HTTPS")
Rel(manager_bo, abs, "Подтверждает условия", "HTTPS")
Rel(new_system, cc_system, "Передаёт данные заявки", "HTTPS/TLS")
Rel(new_system, abs, "Интеграция через промежуточный слой", "Async/Kafka")
Rel(new_system, sms, "Отправляет запросы на уведомления", "HTTPS")
Rel(abs, sms, "Инициирует отправку СМС", "HTTPS")
Rel(sms, client_new, "Отправляет уведомления", "SMS")
Rel(sms, client_ib, "Отправляет уведомления", "SMS")

@enduml